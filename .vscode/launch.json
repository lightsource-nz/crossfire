{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            //   no "rtos" setting: openocd.cfg no longer groups the two cores as an SMP
            // hwthread pair, because examining core 1 at startup stalls this firmware -- core 1
            // runs the message-drain worker and stops while holding the stream lock, after which
            // core 0 blocks forever on its next log call. See openocd-pico2.cfg for the
            // measurements. Core 1 is still reachable on demand; that file says how.
            "name": "cortex-debug launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            //"showDevDebugOutput": "raw",
            "cwd": "${workspaceRoot}/build",
            "configFiles": ["${workspaceRoot}/openocd.cfg"],
            "svdFile": "${workspaceRoot}/../pico-sdk/src/rp2040/hardware_regs/rp2040.svd",
            "request": "launch",
            "executable": "${command:cmake.launchTargetPath}",
            "windows": {
                "serverpath": "C:/Users/aful018/tools/xpack-openocd-0.12.0-7/bin/openocd.exe",
                "armToolchainPath": "C:\\Users\\aful018\\tools\\arm-gnu-toolchain-14.2.rel1-mingw-w64-x86_64-arm-none-eabi\\bin"
            },
            "linux": {
                "armToolchainPath": "/usr/bin",
                "gdbPath": "gdb-multiarch"
            }
        },
        {
            // no "rtos" setting, for the same reason as the entry above
            "name": "cortex-debug launch (pico2)",
            "type": "cortex-debug",
            "servertype": "openocd",
            //"showDevDebugOutput": "raw",
            "cwd": "${workspaceRoot}/build-pico2",
            "configFiles": ["${workspaceRoot}/openocd-pico2.cfg"],
            "svdFile": "${workspaceRoot}/../pico-sdk/src/rp2350/hardware_regs/rp2350.svd",
            "request": "launch",
            "executable": "${command:cmake.launchTargetPath}",
            "windows": {
                "serverpath": "C:/Users/aful018/tools/xpack-openocd-0.12.0-7/bin/openocd.exe",
                "armToolchainPath": "C:\\Users\\aful018\\tools\\arm-gnu-toolchain-14.2.rel1-mingw-w64-x86_64-arm-none-eabi\\bin"
            },
            "linux": {
                "armToolchainPath": "/usr/bin",
                "gdbPath": "gdb-multiarch"
            }
        },
        {
            "name": "native-win64-gcc-12.1.0",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceRoot}/build",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "program": "${command:cmake.launchTargetPath}"
        }
    ]
}